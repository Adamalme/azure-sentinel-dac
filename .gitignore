# Local .terraform directories
.terraform/

# Terraform state files (contain resource details - never commit)
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform plan files (can contain sensitive values)
tfplan
*.tfplan

# Crash log files
crash.log
crash.*.log

# Variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Windows system files
desktop.ini
Thumbs.db